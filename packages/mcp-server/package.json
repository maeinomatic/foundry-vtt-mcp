{
  "name": "@maeinomatic/foundry-mcp-server",
  "version": "0.6.9",
  "description": "MCP server for the independently maintained Foundry VTT MCP bridge",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm -w @maeinomatic/foundry-mcp-shared run build && tsc",
    "build:bundle": "tsc && esbuild dist/index.js --bundle --platform=node --target=node18 --outfile=dist/index.bundle.cjs --format=cjs --define:import.meta.url='\"bundled\"' && esbuild dist/backend.js --bundle --platform=node --target=node18 --outfile=dist/backend.bundle.cjs --format=cjs --define:import.meta.url='\"bundled\"'",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:bundle": "node dist/index.bundle.cjs",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@maeinomatic/foundry-mcp-shared": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.19.0",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.3.0",
    "fast-uri": "^3.1.5",
    "hono": "^4.12.33",
    "werift": "^0.24.3",
    "winston": "^3.11.0",
    "ws": "^8.21.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.27.4",
    "typescript": "5.3.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "foundry-vtt",
    "claude",
    "ai"
  ]
}
